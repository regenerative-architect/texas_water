{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "txos.evidence.v1",
  "type": "object",
  "required": [
    "title",
    "publisher"
  ],
  "properties": {
    "title": {
      "type": "string"
    },
    "publisher": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "retrievalDate": {
      "type": "string"
    },
